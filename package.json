{
  "name": "ink-notebook",
  "version": "1.3.0",
  "description": "Handwritten notebooks for Obsidian in the style of the Boox Notes app: a fast native ink engine for e-ink tablets, pens, highlighter, erasers, lasso, shapes, pages and templates, plus handwriting-to-text with Azure OCR, live diagram figures and PDF annotation.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && node esbuild.config.mjs production",
    "harness": "node dev/build-harness.mjs && node dev/harness-test.cjs",
    "set-version": "node scripts/set-version.mjs"
  },
  "keywords": [
    "obsidian",
    "handwriting",
    "ink",
    "stylus",
    "ocr",
    "eink",
    "boox"
  ],
  "author": "Stefan Mayer",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.8.7",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "pdf-lib": "^1.17.1"
  }
}
